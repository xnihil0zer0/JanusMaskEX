    12	def advance_gate(artifact: Any) -> dict:
    13	    """Enforce fail-closed check on artifact presence, dict type, and correct content hash."""
    14	    if not isinstance(artifact, dict):
    15	        return {'advance': False, 'terminal': 'missing_evidence'}
    16	    if 'content_hash' not in artifact:
    17	        return {'advance': False, 'terminal': 'missing_evidence'}
    18	    expected_hash = artifact['content_hash']
    19	    if not isinstance(expected_hash, str) or not expected_hash:
    20	        return {'advance': False, 'terminal': 'missing_evidence'}
    21	    try:
    22	        artifact_copy = dict(artifact)
    23	        artifact_copy.pop('content_hash', None)
    24	        computed_hash = phase_artifact_hash(artifact_copy)
    25	    except Exception:
    26	        return {'advance': False, 'terminal': 'missing_evidence'}
    27	    if computed_hash == expected_hash:
    28	        return {'advance': True, 'terminal': ''}
    29	    else:
    30	        return {'advance': False, 'terminal': 'hash_mismatch'}
