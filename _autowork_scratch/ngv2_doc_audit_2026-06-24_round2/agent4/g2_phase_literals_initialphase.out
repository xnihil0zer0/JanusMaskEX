     7	def phase_artifact_hash(artifact: Any) -> str:
     8	    """Compute a deterministic SHA-256 hash for the artifact."""
     9	    s = json.dumps(artifact, sort_keys=True, separators=(',', ':'), default=str)
    10	    return hashlib.sha256(s.encode('utf-8')).hexdigest()
